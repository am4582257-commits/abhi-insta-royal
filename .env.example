# Copy these values into your hosting provider's environment settings.
# Never commit real tokens or app secrets.
META_VERIFY_TOKEN=replace_with_a_long_random_string
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Instagram Graph API settings (keep real values out of GitHub)
META_GRAPH_API_VERSION=v24.0
META_GRAPH_API_BASE=https://graph.instagram.com
AUTO_REPLY_TEXT=Namaste! 👋 Aapka message mil gaya hai. Jald reply milega. ✨
